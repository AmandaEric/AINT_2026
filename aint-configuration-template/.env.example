# AINT CONFIGURATION TEMPLATE
# Copy this file to .env and replace the example values.
# NEVER commit .env or put these secrets in frontend JavaScript.

# ----------------------------
# SERVER
# ----------------------------
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# ----------------------------
# DATABASE (MySQL / MariaDB)
# Use the credentials for YOUR database.
# For Railway, use the values from the MySQL service's variables/connect settings.
# For local MySQL, commonly host=127.0.0.1 and port=3306.
# ----------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=aint_user
DB_PASSWORD=replace_with_your_database_password
DB_NAME=aint_db

# Optional: use a Unix socket instead of DB_HOST/DB_PORT.
# Leave DB_HOST blank if using a socket and uncomment/configure DB_SOCKET.
# DB_HOST=
# DB_SOCKET=/path/to/mysql.sock

# ----------------------------
# AI PROVIDER
# Set at least ONE API key for an AI provider.
# You pay the provider directly according to its pricing and usage limits.
# ----------------------------

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional alternate Gemini model, only used if set:
# GEMINI_FALLBACK_MODEL=

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ----------------------------
# EMAIL (only needed for admin login-code emails)
# Choose/configure the provider your server.js actually uses.
# This project version uses Resend.
# ----------------------------
RESEND_API_KEY=
EMAIL_FROM=AINT System <onboarding@resend.dev>

# Optional if you later switch to SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_USER=
# EMAIL_APP_PASSWORD=

# ----------------------------
# OPTIONAL LOCAL / HOSTED SERVICES
# ----------------------------
# KOKORO_TTS_URL=http://localhost:8880
# AI_PORT=3001
