{
    "manifest_version": 3,
    "name": "AINT Exam Monitor",
    "version": "1.2.0",
    "description": "Monitors approved and unauthorized websites during AINT exams.",
    "permissions": [
        "tabs",
        "storage"
    ],
    "host_permissions": [
        "https://*/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*/*",
                "http://127.0.0.1/*",
                "http://localhost/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}