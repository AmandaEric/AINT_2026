
{
    "manifest_version": 3,
    "name": "AINT Exam Monitor",
    "version": "1.1.0",
    "description": "Monitors approved and unauthorized websites during AINT exams.",
  
    "permissions": [
      "tabs",
      "storage"
    ],
  
    "host_permissions": [
      "https://*/*"
    ],
  
    "background": {
      "service_worker": "background.js"
    },
  
    "content_scripts": [
      {
        "matches": [
          "https://*/*"
        ],
        "js": [
          "content.js"
        ],
        "run_at": "document_idle"
      }
    ]
  }
  