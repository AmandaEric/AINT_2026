# ==========================================================
# AINT – per-college configuration
# Copy to .env and fill in. Never commit .env.
# ==========================================================

NODE_ENV=production

# ---- Institution (shown in the UI) ------------------------
INSTITUTION_NAME=Riverbend Community College
INSTITUTION_SHORT_NAME=Riverbend
INSTITUTION_LOGO_URL=https://exams.riverbend.edu/logo.png
INSTITUTION_PRIMARY_COLOR=#1a56db
SUPPORT_EMAIL=itsupport@riverbend.edu

# ---- Server & domains -------------------------------------
# Public URL of this deployment (https, no trailing slash)
PUBLIC_URL=https://exams.riverbend.edu
# Origins allowed to call the API (comma-separated)
ALLOWED_ORIGINS=https://exams.riverbend.edu,https://admin.riverbend.edu
PORT=3000
AI_PORT=3001
AI_SERVICE_URL=http://localhost:3001
TTS_SERVICE_URL=http://localhost:5005

# ---- Database (use DATABASE_URL OR the individual fields) --
DATABASE_URL=
DB_HOST=localhost
DB_PORT=
DB_NAME=aint
DB_USER=aint_app
DB_PASSWORD=
DB_SSL=false

# ---- AI providers (set at least one) ----------------------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=